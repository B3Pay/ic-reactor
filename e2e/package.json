{
  "name": "hello-world",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bash ./test.sh",
    "test": "bash ./test.sh",
    "test:vitest": "vitest run",
    "gen": "candid-core-cli gen src/actor/hello_actor.did -o src/declarations",
    "gen:check": "candid-core-cli gen src/actor/hello_actor.did -o src/declarations --check",
    "icp:start": "icp network start -d",
    "icp:deploy": "icp deploy hello_actor",
    "icp:stop": "icp network stop",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@candid-core/schema": "0.4.0",
    "@ic-reactor/core": "workspace:*",
    "@ic-reactor/react": "workspace:*",
    "@icp-sdk/core": "^6.1.1"
  },
  "devDependencies": {
    "@candid-core/cli": "0.3.0",
    "@ic-reactor/vite-plugin": "workspace:*",
    "@icp-sdk/ic-wasm": "0.11.1",
    "@icp-sdk/icp-cli": "1.7.0",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
