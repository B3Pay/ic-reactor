# Various IDEs and Editors
.vscode/
.idea/
**/*~

# Mac OSX temporary files
.DS_Store
**/.DS_Store

# dfx temporary files
.dfx/

# generated files. src/declarations/ is deliberately NOT ignored: the e2e cases
# import it, so `tsc` cannot resolve the project without it, and CI never runs
# a generator before type-checking. It is committed and updated by hand when
# src/actor/hello_actor.did changes (see README.md).
src/*.generated.ts

# rust
target/

# frontend code
node_modules/
dist/

# environment variables
.env
