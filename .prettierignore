# `pnpm format:check` now walks the whole repo, and Prettier reads only the root
# .gitignore plus this file -- never a nested .gitignore. Every build directory
# that only a nested .gitignore covers has to be repeated here, or the check
# fails in any working tree that has been built: `.next/` and `examples/*/out/`
# alone accounted for 205 of the 249 files a repo-wide check flagged.
.next/
examples/*/out/
dist-ssr/
.tanstack/
.nitro/
.wrangler/
.yarn/
canister_ids.json

# Editor state. Listed in several nested .gitignore files, which Prettier does
# not read, so an untracked settings file would otherwise be rewritten in place.
.vscode/
.idea/

# Claude Code worktrees and machine-local settings. Not covered by the root
# .gitignore, so a repo-wide walk would format files on other agents' branches.
.claude/

# TypeDoc output, rewritten by `pnpm docs:build`. Also in the root .gitignore;
# repeated here so the Prettier set does not silently depend on it.
docs/src/content/docs/libs/

# Rewritten by the TanStack Router plugin on every dev/build run; its own header
# tells you to exclude it from linters and formatters.
examples/tanstack-router/src/routeTree.gen.ts

# pnpm rewrites the lockfile on every install.
pnpm-lock.yaml

# evals/: inputs kept byte-identical to what produced them (evals/setup.mjs
# regenerates them) — candid-core-cli output, the docs copied from the published
# @candid-core and @ic-reactor packages, the vendored fake replica — plus
# agent-run results.
evals/conditions/*/starter/src/generated/icrc1.ts
evals/conditions/*/docs/
evals/harness/public/support/fake-replica.js
evals/runs/
# The pilots' aggregated results, kept byte for byte as evals/drive.mjs wrote
# them: they are the record PREREGISTRATION.md cites.
evals/results/

# packages/core/tests/fixtures/: modules and a Contract envelope written by
# `candid-core-cli gen`, kept byte for byte (see the README there).
packages/core/tests/fixtures/*.ts
packages/core/tests/fixtures/*.envelope.json

# scripts/check-snippets/app/generated/: the modules `candid-core-cli gen` writes
# for the `.did` files next to them, kept byte for byte. They are what a guide
# snippet's `./generated/<name>` import resolves to.
scripts/check-snippets/app/generated/*.ts

# The modules and Contract envelopes `candid-core-cli gen` (run by
# @ic-reactor/vite-plugin or an example's `gen` script) writes from an example's
# .did, kept byte for byte so that `gen:check` passes. Listed by name, not by a
# glob over src/canisters/: a hand-written module put next to them (a stable
