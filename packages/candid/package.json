{
  "name": "@ic-reactor/candid",
  "version": "3.12.2",
  "description": "IC Reactor Candid Adapter - Fetch and parse Candid definitions from Internet Computer canisters",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!**/*.tsbuildinfo",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "test": "vitest run",
    "size": "size-limit",
    "analyze": "size-limit",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B3Pay/ic-reactor",
    "directory": "packages/candid"
  },
  "bugs": {
    "url": "https://github.com/B3Pay/ic-reactor/issues"
  },
  "homepage": "https://ic-reactor.b3pay.net/v3/packages/candid",
  "keywords": [
    "internet-computer",
    "icp",
    "dfinity",
    "candid",
    "web3",
    "blockchain",
    "canister",
    "actor",
    "reactor",
    "ic-reactor",
    "llms",
    "ai-friendly"
  ],
  "author": "Behrad Deylami",
  "license": "MIT",
  "dependencies": {
    "@ic-reactor/core": "workspace:^",
    "@ic-reactor/parser": "workspace:^",
    "@noble/hashes": "^2.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@icp-sdk/core": "^6.1.0",
    "@noble/hashes": "^2.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@icp-sdk/core": "^6.1.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.4.0",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.11"
  },
  "size-limit": [
    {
      "name": "Candid Package",
      "path": "dist/index.js",
      "limit": "30 KB",
      "gzip": true,
      "ignore": [
        "@ic-reactor/parser",
        "zod"
      ]
    }
  ]
}
