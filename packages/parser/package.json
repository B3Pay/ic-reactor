{
  "name": "@ic-reactor/parser",
  "version": "0.4.7",
  "description": "A parser for the DFINITY Candid language",
  "sideEffects": false,
  "files": [
    "dist/web/*",
    "dist/nodejs/*",
    "dist/bundler/*",
    "!dist/**/.gitignore",
    "README.md",
    "LICENSE_MIT",
    "LICENSE_APACHE"
  ],
  "main": "dist/nodejs/index.js",
  "module": "dist/web/index.js",
  "types": "dist/nodejs/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "workerd": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "node": {
        "types": "./dist/nodejs/index.d.ts",
        "default": "./dist/nodejs/index.js"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B3Pay/ic-reactor.git",
    "directory": "packages/parser"
  },
  "keywords": [
    "internet-computer",
    "icp",
    "dfinity",
    "candid",
    "parser",
    "actor",
    "react",
    "web3",
    "dapp",
    "wasm"
  ],
  "author": "b3hr4d",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/B3Pay/ic-reactor/issues"
  },
  "homepage": "https://github.com/B3Pay/ic-reactor/tree/main/packages/parser#readme",
  "scripts": {
    "build": "npm run clean && npm run build:web && npm run build:node && npm run build:bundler && node scripts/append-types.js",
    "build:web": "wasm-pack build --release --target web --out-dir dist/web --out-name index",
    "build:node": "wasm-pack build --release --target nodejs --out-dir dist/nodejs --out-name index",
    "build:bundler": "wasm-pack build --release --target bundler --out-dir dist/bundler --out-name index",
    "prepack": "find dist -name .gitignore -delete",
    "start": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "size": "size-limit",
    "analyze": "size-limit"
  },
  "devDependencies": {
    "@ic-reactor/candid": "workspace:*",
    "@ic-reactor/core": "workspace:*",
    "@icp-sdk/auth": "^7.1.0",
    "@icp-sdk/core": "^6.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tanstack/query-core": "^5.101.4",
    "@types/node": "^26.2.0",
    "size-limit": "^12.1.0",
    "vitest": "^4.1.10",
    "wasm-pack": "0.15.0"
  },
  "size-limit": [
    {
      "name": "Parser (web)",
      "path": "dist/web/index.js",
      "limit": "200 KB",
      "gzip": true
    }
  ],
  "gitHead": "36e43368cb0fa3bffa9aa40dfd589046c1c3b5fe"
}
