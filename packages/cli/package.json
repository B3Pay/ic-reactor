{
  "name": "@ic-reactor/cli",
  "version": "0.13.1",
  "type": "module",
  "description": "CLI tool to generate shadcn-style React hooks for ICP canisters",
  "bin": {
    "ic-reactor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --no-splitting",
    "dev": "tsup src/index.ts --format esm --watch --no-splitting",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "keywords": [
    "internet-computer",
    "icp",
    "dfinity",
    "react",
    "cli",
    "codegen",
    "ic-reactor",
    "llms",
    "ai-friendly"
  ],
  "author": "Behrad Deylami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B3Pay/ic-reactor.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/B3Pay/ic-reactor/issues"
  },
  "homepage": "https://ic-reactor.b3pay.net/v3/packages/cli",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@ic-reactor/codegen": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "schema.json",
    "README.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  }
}
