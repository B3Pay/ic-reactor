{
  "name": "@ic-reactor/codegen",
  "version": "0.13.0",
  "description": "Shared code generation utilities for IC Reactor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__snapshots__/**",
    "!**/*.tsbuildinfo",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --tsconfig tsconfig.json",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "keywords": [
    "internet-computer",
    "candid",
    "ic-reactor",
    "codegen",
    "dfinity",
    "icp"
  ],
  "author": "Behrad Deylami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B3Pay/ic-reactor.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://ic-reactor.b3pay.net/v3/packages/codegen",
  "dependencies": {
    "@ic-reactor/parser": "workspace:*",
    "change-case": "^5.4.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
