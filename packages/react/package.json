{
  "name": "@ic-reactor/react",
  "version": "4.0.0-alpha.0",
  "description": "ic-reactor 4 React bindings: a provider that owns one client per tree, useClient and useAuth",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!**/*.tsbuildinfo",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "size": "size-limit",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B3Pay/ic-reactor",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/B3Pay/ic-reactor/issues"
  },
  "homepage": "https://ic-reactor.b3pay.net/v3/packages/react",
  "keywords": [
    "internet-computer",
    "icp",
    "dfinity",
    "react",
    "hooks",
    "web3",
    "blockchain",
    "canister",
    "tanstack-query",
    "ic-reactor",
    "llms",
    "ai-friendly"
  ],
  "author": "Behrad Deylami",
  "license": "MIT",
  "peerDependencies": {
    "@ic-reactor/core": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@candid-core/schema": "0.3.0-beta.1",
    "@ic-reactor/core": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^13.0.3",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "name": "React bindings",
      "path": "dist/index.js",
      "limit": "1.2 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react/jsx-runtime",
        "@ic-reactor/core",
        "@tanstack/react-query"
      ]
    }
  ]
}
