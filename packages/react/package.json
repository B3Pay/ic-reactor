{
  "name": "@ic-reactor/react",
  "version": "3.12.3",
  "description": "IC Reactor React library for building Internet Computer apps",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!**/*.tsbuildinfo",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "size": "size-limit",
    "analyze": "size-limit",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B3Pay/ic-reactor",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/B3Pay/ic-reactor/issues"
  },
  "homepage": "https://ic-reactor.b3pay.net/v3/packages/react",
  "keywords": [
    "internet-computer",
    "icp",
    "dfinity",
    "react",
    "hooks",
    "web3",
    "blockchain",
    "canister",
    "tanstack-query",
    "ic-reactor",
    "llms",
    "ai-friendly"
  ],
  "author": "Behrad Deylami",
  "license": "MIT",
  "dependencies": {
    "@ic-reactor/core": "workspace:^"
  },
  "peerDependencies": {
    "@icp-sdk/auth": "^8.0.0",
    "@icp-sdk/core": "^6.1.0",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^6.1.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.11"
  },
  "size-limit": [
    {
      "name": "React Library",
      "path": "dist/index.js",
      "limit": "30 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@ic-reactor/core",
        "@tanstack/react-query",
        "@icp-sdk/auth"
      ]
    }
  ],
  "peerDependenciesMeta": {
    "@icp-sdk/auth": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
