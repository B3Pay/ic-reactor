{
  "name": "node-agent-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "cli": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "demo": "node --disable-warning=ExperimentalWarning src/cli.ts demo",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "candid-core-cli gen icrc1.did -o src/canisters",
    "gen:check": "candid-core-cli gen icrc1.did -o src/canisters --check"
  },
  "dependencies": {
    "@candid-core/schema": "0.3.0-beta.1",
    "@ic-reactor/core": "^4.0.0-beta.1",
    "@icp-sdk/core": "^6.1.0",
    "@noble/curves": "^2.2.0",
    "@tanstack/query-core": "^5.102.8"
  },
  "devDependencies": {
    "@candid-core/cli": "0.2.0-beta.1",
    "@icp-sdk/icp-cli": "1.2.0",
    "@types/node": "^26.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
