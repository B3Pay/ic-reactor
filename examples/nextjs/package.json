  "private": true,
  "author": "b3hr4d <b3hr4d@live.com>",
  "description": "Internet Computer Rust + NextJS Template",
  "keywords": [
    "nextjs",
    "rust",
    "internet computer",
    "icp",
    "starter",
    "dfinity"
  ],
  "scripts": {
    "install:all": "pnpm install && pnpm ic-wasm:install && pnpm candid:install",
    "candid:install": "cargo install candid-extractor",
    "ic-wasm:install": "cargo install ic-wasm",
    "build": "next build --webpack",
    "start": "next start",
    "export": "next build --webpack",
    "dev": "next dev --webpack",
    "dfx:start": "dfx start --background --clean",
    "dfx:stop": "dfx stop",
    "dfx:pull": "dfx deps pull",
    "dfx:build": "dfx build",
    "deploy": "dfx deploy",
    "generate": "dfx generate"
  },
  "dependencies": {
    "@ic-reactor/react": "^3.11.0",
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^6.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "next": "^16.3.1",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
