{
  "name": "canister-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "candid-core-cli gen did/icrc1.did did/icp_ledger.did did/ckbtc_minter.did -o src/canisters",
    "gen:check": "candid-core-cli gen did/icrc1.did did/icp_ledger.did did/ckbtc_minter.did -o src/canisters --check",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@candid-core/cli": "0.3.0",
    "@candid-core/schema": "0.4.0",
    "@ic-reactor/core": "^4.0.0",
    "@ic-reactor/react": "^4.0.0",
    "@icp-sdk/auth": "^10.0.1",
    "@icp-sdk/core": "^6.1.1",
    "@noble/curves": "^2.4.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ic-reactor/vite-plugin": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
