{
  "name": "canister-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "meant gen did/icrc1.did did/icp_ledger.did did/ckbtc_minter.did -o src/canisters",
    "gen:check": "meant gen did/icrc1.did did/icp_ledger.did did/ckbtc_minter.did -o src/canisters --check",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@meantjs/cli": "0.5.1",
    "@meantjs/schema": "0.6.0",
    "@ic-reactor/core": "^4.3.0",
    "@ic-reactor/react": "^4.3.0",
    "@icp-sdk/auth": "^11.2.0",
    "@icp-sdk/core": "^6.1.1",
    "@noble/curves": "^2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ic-reactor/vite-plugin": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
